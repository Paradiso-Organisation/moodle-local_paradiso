{{!
    @template local_paradiso/status

    Paradiso tools registered from the configured workspace.

    Example context (json):
    {
        "hastools": true,
        "tools": [
            { "name": "Paradiso Presentations", "status": "Active", "inchooser": "Yes" }
        ]
    }
}}
{{#hastools}}
<table class="table generaltable">
    <thead>
        <tr>
            <th scope="col">{{#str}}colname, local_paradiso{{/str}}</th>
            <th scope="col">{{#str}}colstatus, local_paradiso{{/str}}</th>
            <th scope="col">{{#str}}colchooser, local_paradiso{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#tools}}
        <tr>
            <td>{{name}}</td>
            <td>{{status}}</td>
            <td>{{inchooser}}</td>
        </tr>
        {{/tools}}
    </tbody>
</table>
{{/hastools}}
{{^hastools}}
<p>{{#str}}notools, local_paradiso{{/str}}</p>
{{/hastools}}
